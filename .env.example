# Copy this file to ".env" and fill in your own values. The .env file is
# gitignored so your keys are never committed.
#
# USDA NASS Quick Stats API key — enables the county crop-acreage data source
# (crop-context features + "lbs per cropland acre" normalization).
# Get a free key at: https://quickstats.nass.usda.gov/api
NASS_API_KEY=

# EPA CAMD / Clean Air Markets (CAMPD) API key — enables the power-plant
# emissions data source (CEMS SO2/NOx/CO2 under 40 CFR Part 75).
# Get a free key at: https://www.epa.gov/power-sector/cam-api-portal
CAMD_API_KEY=

# U.S. EIA Open Data API key — enables the power-plant inventory (EIA Form 860:
# all Michigan plants >=1 MW, incl. nuclear/renewables not in CAMD).
# Get a free key at: https://www.eia.gov/opendata/
EIA_API_KEY=
